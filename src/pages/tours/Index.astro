---
import Layout from '../layouts/Layout.astro';
import { tours } from '../data/tours';
---

<Layout title="Tours and Prices">
  <h1>Tours and Prices</h1>
  <p>The best of local nature and cultural tours awaits</p>

  <section class="tour-grid">
    {tours.map((tour) => (
      <a href={`/tours/${tour.slug}`} class="tour-card">
        <img src={tour.image} alt={tour.title} />
        <div class="card-content">
          <h2>{tour.title}</h2>
          <p>{tour.summary}</p>
          <div class="meta">
            <span>{tour.difficulty}</span>
            <span>${tour.price} USD</span>
          </div>
        </div>
      </a>
    ))}
  </section>
</Layout>

<style>
.tour-grid {
  display: grid;
  gap: 2rem;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.tour-card {
  text-decoration: none;
  color: inherit;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #ddd;
  transition: transform .2s ease, box-shadow .2s ease;
}

.tour-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.12);
}

.tour-card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.card-content {
  padding: 1rem;
}

.meta {
  margin-top: .75rem;
  display: flex;
  justify-content: space-between;
  font-size: .9rem;
  color: #555;
}
</style>
