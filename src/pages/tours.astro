---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tours and Prices">
<h1>Tours and Prices</h1>
<p>Click on a tour to view more details:</p>

<ul class="tour-list">
<li class="tour-item">
<button class="tour-toggle">
City Tour Cusco
<span class="arrow">▼</span>
</button>
<div class="tour-details">
<p>Includes cathedral, Qoricancha, and surrounding ruins.</p>
<p><strong>Price:</strong> $45 USD</p>
</div>
</li>

<li class="tour-item">
<button class="tour-toggle">
Sacred Valley Tour
<span class="arrow">▼</span>
</button>
<div class="tour-details">
<p>Visit Pisac, Ollantaytambo, and Chinchero with lunch included.</p>
<p><strong>Price:</strong> $65 USD</p>
</div>
</li>

<li class="tour-item">
<button class="tour-toggle">
Machu Picchu Full Day
<span class="arrow">▼</span>
</button>
<div class="tour-details">
<p>Round-trip train, guided tour, entrance ticket included.</p>
<p><strong>Price:</strong> $280 USD</p>
</div>
</li>
</ul>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', () => {
const toggles = document.querySelectorAll('.tour-toggle');

toggles.forEach((toggle) => {
toggle.addEventListener('click', () => {
const details = toggle.nextElementSibling;
const arrow = toggle.querySelector('.arrow');

// Toggle visibility
details.classList.toggle('open');

// Toggle arrow direction
arrow.textContent = details.classList.contains('open') ? '▲' : '▼';
});
});
});
</script>

<style>
.tour-list {
list-style: none;
padding: 0;
margin: 0;
}

.tour-item {
margin-bottom: 1rem;
border: 1px solid #ccc;
border-radius: 6px;
overflow: hidden;
}

.tour-toggle {
width: 100%;
background: none;
border: none;
padding: 1rem;
text-align: left;
font-size: 1.2rem;
font-weight: bold;
cursor: pointer;
background-color: #f5f5f5;
display: flex;
justify-content: space-between;
align-items: center;
}

.tour-toggle:hover {
background-color: #e5e5e5;
}

.tour-details {
display: none;
padding: 1rem;
background-color: #fff;
}

.tour-details.open {
display: block;
}

.arrow {
font-size: 1rem;
transition: transform 0.3s ease;
}
</style>
</Layout>
