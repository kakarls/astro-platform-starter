---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Journey through the wild Amazonian jungle and explore ancient Incan ruins.

With Suyos Del Inca, you can explore the ancient routes of the Incan empire, travel down rivers where the Amazon and Andes mountains meet, and visit native communities, all with our expert local guides. 
Are you ready for the adventure of a lifetime?
`;
---

<Layout title="Suyos Del Inca">
    <ContextAlert class="mb-8" />
    <h1 class="mb-10">welcome to SUYOS DEL INCA</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />
    <p>
        <a href="/tours" class="btn btn-lg sm:min-w-64">See Tour Options</a>
    </p>
</Layout>
